# Input method entry for Superior-IME.
#
# Fcitx5 derives the unique name from the file name, so this registers the
# input method as "super-ime". It deliberately does not reuse "pinyin", which
# already belongs to the stock entry.
#
# Addon=superiorpinyin: the engine is the bundled librime adapter in
# libsuperiorpinyin.so. There is exactly one entry; the libime-backed one was
# removed when the engine moved in-tree, so there is no duplicate to choose
# between and no shared state with Fcitx5's pinyin addon.
[InputMethod]
Name=先！进！输入法
Name[zh_CN]=先！进！输入法
Name[zh_TW]=先！進！輸入法
Comment=Built-in pinyin engine (Wanxiang schema) with the Superior skin and toolbar
Comment[zh_CN]=内置拼音引擎（万象方案），由 Superior 提供皮肤与状态栏
Comment[zh_TW]=內建拼音引擎（萬象方案），由 Superior 提供面板與狀態列
Icon=org.superior.ime
Label=进
LangCode=zh_CN
Addon=superiorpinyin
Configurable=False
