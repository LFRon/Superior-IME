# The Fcitx5 host.
#
# Since v3 this one addon is both the input method engine and the runtime host:
# it translates keys, executes text edits, presents scenes and mirrors the
# native candidate panel. Keeping the observer and the engine in two addons made
# the candidate list an implicit channel between them, with two owners of one
# composition (the v2 `CloudContext` hacks).
#
# librime is loaded at runtime with dlopen, so the addon still loads on a machine
# without it: the runtime reports "engine unavailable" and forwards keys.
[Addon]
Name=Superior IME
Name[zh_CN]=先！进！输入法
Name[zh_TW]=先！進！輸入法
Comment=Superior IME host: librime (Wanxiang schema), runtime and overlay bridge
Comment[zh_CN]=先！进！输入法：librime（万象方案）、内核与浮层桥接
Comment[zh_TW]=先！進！輸入法：librime（萬象方案）、內核與浮層橋接
Type=SharedLibrary
Library=libsuperiorpinyin
Category=InputMethod
OnDemand=True
Version=@PROJECT_VERSION@
Configurable=False

[Addon/Dependencies]
0=core:@FCITX5_CORE_VERSION@
